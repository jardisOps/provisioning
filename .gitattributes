# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
*.php text eol=lf diff=php

# Configuration files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
composer.lock text eol=lf merge=union

# Documentation
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Environment files
.env* text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf

# Export-ignore (exclude from composer archive)
/.github export-ignore
/tests export-ignore
# support/makefile/provision.mk MUST ship: ProjectInstaller writes
# `include vendor/jardisops/provisioning/support/makefile/provision.mk` into the
# consumer's Makefile. Only the dev-only files under support/ are excluded.
/support/docker-compose.yml export-ignore
/support/pre-commit-hook.sh export-ignore
/support/makefile/composer.mk export-ignore
/support/makefile/docker.mk export-ignore
/support/makefile/hooks.mk export-ignore
/support/makefile/qa-stack.mk export-ignore
/support/makefile/ssh.mk export-ignore
/support/makefile/stack.mk export-ignore
/.claude export-ignore
/vendor export-ignore
.idea export-ignore
.editorconfig export-ignore
.dockerignore export-ignore
.gitattributes export-ignore
.gitignore export-ignore
/Makefile export-ignore
phpcs.xml export-ignore
phpstan.neon export-ignore
phpunit.xml export-ignore
.env export-ignore
